# Normalize line endings: store text as LF in the repo, check out native on each OS.
* text=auto

# Explicit text types (keep LF in the repo regardless of platform)
*.py     text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.json   text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.spec   text eol=lf

# Windows-only scripts keep CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary assets — never touch line endings, and skip textual diffs
*.elf    binary
*.pyz    binary
*.bin    binary
*.dll    binary
*.exe    binary
*.pkg    binary
*.zip    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
